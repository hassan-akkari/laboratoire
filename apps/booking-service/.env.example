# === Database (Neon Postgres) ===
# Create a project at https://neon.tech, copy the pooled connection string.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# === Admin (single-admin MVP, iron-session cookie) ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# Must be >= 32 chars. Used to seal the admin_session cookie.
ADMIN_SESSION_SECRET=at-least-32-chars-of-random-data-please-change-me

# Note: with DATABASE_URL empty, the app still boots — DB queries return sample
# data and the UI shows a demo banner. To go live: set DATABASE_URL, then run
# `pnpm -F booking-service db:migrate` and `db:seed` (never db:push — the
# database is shared with sibling apps; see README "Database & migrations").
